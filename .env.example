# ──────────────────────────────────────────────────────────────
# このファイルをコピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みなのでコミットされません（秘密はこちらへ）。
# ──────────────────────────────────────────────────────────────

# ① 頭脳(LLM) の選択: mock | ollama | anthropic | openai
#    - mock   : 鍵もLLMも不要。キーワードでツールを決め打ち。まず動かす用。
#    - ollama : ローカルLLM(要 `ollama serve`)。本物のツール選択を体験できる。
#    - anthropic / openai : 各社のAPIキーがある場合。
AI_PROVIDER=mock

# ② Ollama 設定 (AI_PROVIDER=ollama のとき)
#    Ollama は OpenAI 互換APIを出すので baseURL を向けるだけ。
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# ③ 各社APIキー (使う場合のみ)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ④ MiiTel データソース
#    未設定なら lib/miitel/mock-data.ts のダミーデータを使う。
#    実データを使うときは下のMCP設定を埋める。
# MIITEL_MCP_URL=https://mcp.miitel.ai/mcp
# MIITEL_MCP_TOKEN=<本番MiiTelで発行したBearerトークン>
