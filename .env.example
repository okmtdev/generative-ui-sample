# ──────────────────────────────────────────────────────────────
# このファイルをコピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みなのでコミットされません（秘密はこちらへ）。
# ──────────────────────────────────────────────────────────────

# ① 頭脳(LLM) の選択: mock | ollama | anthropic | openai
#    - mock   : 鍵もLLMも不要。キーワードでツールを決め打ち。まず動かす用。
#    - ollama : ローカルLLM(要 `ollama serve`)。本物のツール選択を体験できる。
#    - anthropic / openai : 各社のAPIキーがある場合。
AI_PROVIDER=mock

# ② Ollama 設定 (AI_PROVIDER=ollama のとき)
#    Ollama は OpenAI 互換APIを出すので baseURL を向けるだけ。
#    モデルの選び方は README「② 本物の LLM をローカルで」を参照。
#      - 高精度(48GB Mac)        : qwen3:32b   ← 既定
#      - 軽量・手軽(16GB前後)     : qwen3:8b / qwen3:4b
#      - 最高精度(64GB+ Mac)     : gpt-oss:120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:32b

# ③ 各社APIキー (使う場合のみ)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ④ MiiTel データソース (MCP)
#    未設定なら lib/miitel/mock-data.ts のダミーデータを使う。
#    実データを使うときは MIITEL_MCP_URL ＋ 認証情報を設定する。
# MIITEL_MCP_URL=https://mcp.miitel.ai/mcp

#    認証は2通り（どちらか）:
#    (推奨) access_key を置くと、authenticate して期限付きトークンを
#           自動取得・更新する（lib/miitel/auth.ts）。
# MIITEL_COMPANY_ID=
# MIITEL_ACCESS_KEY_ID=
# MIITEL_ACCESS_KEY_SECRET=
# MIITEL_AUTH_URL=https://api.miitel.com/api/auth/v2/authenticate   # 正しいベースURLは公式で確認

#    (簡易) 期限内の静的トークンを直接指定（手元検証向け。期限切れで401になる）。
# MIITEL_MCP_TOKEN=<期限内のBearerトークン>
